APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://littlelight:littlelight@postgres:5432/littlelight?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
MIGRATIONS_DIR=server/migrations
# AI_PROVIDER can be blank for auto mode. With LLM_API_KEY and LLM_BASE_URL set, the API uses an OpenAI-compatible LLM provider.
AI_PROVIDER=
AI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Optional Docker build/runtime images. Override these locally if Docker Hub is slow
# or an internal registry mirror is required.
GO_IMAGE=golang:1.22-alpine
ALPINE_IMAGE=alpine:3.20
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmjs.org/
