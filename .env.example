APP_ENV=local
# Use APP_ENV=docker for local Compose and APP_ENV=prod or production for release.
HTTP_ADDR=:8080
DATABASE_URL=postgres://littlelight:littlelight@postgres:5432/littlelight?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
MIGRATIONS_DIR=server/migrations
SESSION_SECRET=change-me-in-deploy
# Local development may enable these; prod/production startup rejects them.
AUTH_ALLOW_DEV_USER=true
AUTH_ALLOW_MOCK_LOGIN=true
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
# Required for real /api/v1/auth/wechat code exchange outside local H5 mock fallback.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# AI_PROVIDER can be blank for auto mode. With LLM_API_KEY and LLM_BASE_URL set, the API uses an OpenAI-compatible LLM provider.
AI_PROVIDER=
AI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Xfyun streaming ASR for realtime voice dictation.
XF_ASR_APP_ID=
XF_ASR_API_KEY=
XF_ASR_API_SECRET=
XF_ASR_ENDPOINT=wss://iat-api.xfyun.cn/v2/iat
XF_ASR_MAX_SESSION_SECONDS=55
XF_ASR_MAX_CONCURRENT_PER_USER=1
XF_ASR_DAILY_LIMIT_PER_USER=80

# Optional Docker build/runtime images. Override these locally if Docker Hub is slow
# or an internal registry mirror is required.
GO_IMAGE=golang:1.22-alpine
ALPINE_IMAGE=alpine:3.20
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmjs.org/
